# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Job board credentials (optional — only needed for scraping gated content)
LINKEDIN_EMAIL=you@example.com
LINKEDIN_PASSWORD=yourpassword

# Application settings
AUTONOMOUS_MODE=false          # true = no human review before submit
MAX_RETRIES=3                  # self-healing retry attempts per application
DAILY_APPLY_LIMIT=10           # max Easy Apply per day (LinkedIn safety)
HEADLESS_BROWSER=true          # set false to watch Playwright in action

# Storage paths (defaults are relative to project root)
STORAGE_DIR=storage
DATA_DIR=data

# Logging
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FILE=storage/job_auto.log
